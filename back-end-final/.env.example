# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME="Smart Bot Backend"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=new_back
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis (cache + websocket pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=

# --- LLM Providers (set the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_HOST=http://localhost:11434
# LLM_PROVIDER can be openai, anthropic, gemini/google, or ollama.
LLM_PROVIDER=ollama
# For Gemini use e.g. models/gemini-2.5-flash.
LLM_MODEL=fastAPI_Model
OLLAMA_KEEP_ALIVE=24h
# Edit/codegen prompts carry real source files; 8192 starves them and the
# pipeline clamps generated output to ~35% of this value.
OLLAMA_NUM_CTX=32768
OLLAMA_AUTO_WARMUP=true
# Ollama models must be installed/created manually; backend never auto-pulls.
OLLAMA_AUTO_PULL=false

# --- File Storage ---
MEDIA_ROOT=./media
PROJECTS_ROOT=./media/projects
MAX_UPLOAD_BYTES=10485760          # 10 MB

# --- Limits ---
MAX_PROJECTS_PER_USER=10
RATE_LIMIT_LLM_PER_MINUTE=20
